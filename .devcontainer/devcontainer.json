{
  "name": "atcoder-ndpc",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "containerEnv": {
    "TZ": "Asia/Tokyo"
  },
  "features": {
    "ghcr.io/devcontainers/features/ruby:1": {
      "version": "3.4.5"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22.18.0"
    },
    "ghcr.io/fumtas1k/devcontainer-features/atcoder-toolkit:1": {
      "ojVersion": "11.5.1",
      "apiClientVersion": "10.10.1",
      "accVersion": "2.2.0"
    },
    "ghcr.io/fumtas1k/devcontainer-features/atcoder-ruby:1": {
      "gems": "ac-library-rb@1.2.0 rbtree@0.4.6 numo-narray@0.9.2.1 sorted_containers@1.1.0 ruby-lsp"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    "source=atcoder-oj-config,target=/home/vscode/.config/online-judge-tools,type=volume",
    "source=atcoder-oj-data,target=/home/vscode/.local/share/online-judge-tools,type=volume",
    "source=atcoder-acc-config,target=/home/vscode/.config/atcoder-cli-nodejs,type=volume",
    "source=atcoder-claude,target=/home/vscode/.claude,type=volume",
    "source=atcoder-gh-config,target=/home/vscode/.config/gh,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp"
      ],
      "settings": {
        "rubyLsp.rubyVersionManager": {
          "identifier": "rvm"
        }
      }
    }
  },
  "remoteUser": "vscode"
}
